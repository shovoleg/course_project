{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.login'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <h1 class="h3 mb-3">{{ 'auth.login'|trans }}</h1>
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, error.messageKey starts with 'auth.' ? 'messages' : 'security') }}</div>
            {% endif %}
            <form method="post">
                <div class="mb-3">
                    <label class="form-label" for="username">{{ 'auth.email'|trans }}</label>
                    <input class="form-control" type="email" id="username" name="_username" value="{{ last_username }}" required autofocus autocomplete="username">
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">{{ 'auth.password'|trans }}</label>
                    <input class="form-control" type="password" id="password" name="_password" required autocomplete="current-password">
                </div>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                <button class="btn btn-primary" type="submit">{{ 'auth.login'|trans }}</button>
            </form>
            <div class="d-grid gap-3 mt-4">
                <a class="btn btn-outline-secondary btn-lg d-flex align-items-center justify-content-center gap-3 py-3 fw-medium shadow-sm" style="border-width:1.5px;border-color:#dadce0;background:#fff;color:#3c4043;font-size:1.05rem;letter-spacing:.15px;" href="{{ path('oauth_google_start') }}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 48 48" aria-hidden="true" style="flex-shrink:0;"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.3 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.57-.14-3.08-.4-4.55H24v8.51h12.64c-.55 2.96-2.22 5.47-4.74 7.14l7.34 5.69C43.82 37.51 46.5 31.32 46.5 24.5z"/><path fill="#FBBC05" d="M10.54 28.59a14.5 14.5 0 0 1-.76-4.59c0-1.59.28-3.14.76-4.59l-7.98-6.19A23.96 23.96 0 0 0 0 24c0 3.87.93 7.53 2.56 10.78l7.98-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.34-5.69C30.3 38.25 27.34 39.5 24 39.5c-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/><path fill="none" d="M0 0h48v48H0z"/></svg>
                    {{ 'auth.google'|trans }}
                </a>
                <a class="btn btn-outline-secondary btn-lg d-flex align-items-center justify-content-center gap-3 py-3 fw-medium shadow-sm" style="border-width:1.5px;border-color:#dadce0;background:#fff;color:#24292f;font-size:1.05rem;letter-spacing:.15px;" href="{{ path('oauth_github_start') }}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" style="flex-shrink:0;"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.19 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
                    {{ 'auth.github'|trans }}
                </a>
            </div>
            {% if not google or not github %}
                <p class="form-text mt-2">{{ 'auth.oauth_unconfigured'|trans }}</p>
            {% endif %}
            <p class="mt-3"><a href="{{ path('app_register') }}">{{ 'auth.no_account'|trans }}</a></p>
        </div>
    </div>
{% endblock %}
