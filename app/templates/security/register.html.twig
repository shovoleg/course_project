{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.register'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <h1 class="h3 mb-3">{{ 'auth.register'|trans }}</h1>
            {{ form_start(form) }}
                {{ form_widget(form) }}
                <button class="btn btn-primary" type="submit">{{ 'auth.register'|trans }}</button>
            {{ form_end(form) }}
            <p class="mt-3"><a href="{{ path('app_login') }}">{{ 'auth.have_account'|trans }}</a></p>
        </div>
    </div>
{% endblock %}
