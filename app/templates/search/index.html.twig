{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.search'|trans }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">{{ 'nav.search'|trans }}{% if query %}: {{ query }}{% endif %}</h1>
    <h2 class="h5">{{ 'search.positions'|trans }}</h2>
    <div class="table-responsive mb-4">
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'position.title'|trans }}</th>
                    <th>{{ 'common.updated'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for position in positions %}
                    <tr>
                        <td><a href="{{ path('app_position_show', {id: position.id}) }}">{{ position.title }}</a></td>
                        <td>{{ position.updatedAt|date('Y-m-d H:i') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="2">{{ 'search.empty'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <h2 class="h5">{{ 'search.cvs'|trans }}</h2>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'cv.owner'|trans }}</th>
                    <th>{{ 'position.title'|trans }}</th>
                    <th>{{ 'cv.likes'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for cv in cvs %}
                    <tr>
                        <td>{{ names[cv.owner.id]|default(cv.owner.email) }}</td>
                        <td><a href="{{ path('app_cv_show', {id: cv.id}) }}">{{ cv.position.title }}</a></td>
                        <td>{{ likes[cv.id]|default(0) }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="3">{{ 'search.empty'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
