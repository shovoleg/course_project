{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.positions'|trans }}{% endblock %}

{% block body %}
    <div data-controller="table-toolbar">
        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
            <h1 class="h3 mb-0">{{ 'nav.positions'|trans }}</h1>
            <div class="btn-toolbar gap-2">
                {% if is_granted('ROLE_RECRUITER') %}
                    <a class="btn btn-primary btn-sm" href="{{ path('app_position_new') }}">{{ 'action.create'|trans }}</a>
                    <button class="btn btn-outline-primary btn-sm" type="button" data-table-toolbar-target="needsSelection" data-action="table-toolbar#open" data-table-toolbar-url-param="{{ path('app_position_edit', {id: 999999})|replace({'999999': '__id__'}) }}">{{ 'action.edit'|trans }}</button>
                    <form method="post" data-action-template="{{ path('app_position_duplicate', {id: 999999})|replace({'999999': '__id__'}) }}">
                        <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                        <button class="btn btn-outline-secondary btn-sm" data-table-toolbar-target="needsSelection" data-action="table-toolbar#assign">{{ 'action.duplicate'|trans }}</button>
                    </form>
                    <form method="post" data-action-template="{{ path('app_position_delete', {id: 999999})|replace({'999999': '__id__'}) }}" data-confirm="{{ 'user.confirm_delete_position'|trans }}">
                        <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                        <input type="hidden" name="version">
                        <button class="btn btn-outline-danger btn-sm" data-table-toolbar-target="needsSelection" data-action="table-toolbar#assign">{{ 'action.delete'|trans }}</button>
                    </form>
                {% endif %}
                <button class="btn btn-outline-primary btn-sm" type="button" data-table-toolbar-target="needsSelection" data-action="table-toolbar#open" data-table-toolbar-url-param="{{ path('app_position_show', {id: 999999})|replace({'999999': '__id__'}) }}">{{ 'action.view'|trans }}</button>
            </div>
        </div>
        <form class="row g-2 mb-3" method="get">
            <div class="col-md-3">
                <select class="form-select" name="level" aria-label="{{ 'position.level'|trans }}">
                    <option value="">{{ 'position.all_levels'|trans }}</option>
                    {% for item in levels %}
                        <option value="{{ item.value }}" {{ level == item.value ? 'selected' }}>{{ ('position.level.' ~ item.value)|trans }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <input class="form-control" name="tag" value="{{ tag }}" placeholder="{{ 'position.tags'|trans }}">
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary" type="submit">{{ 'position.filters'|trans }}</button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th></th>
                        <th><a href="{{ path('app_position_index', {sort: 'title', dir: dir == 'ASC' ? 'DESC' : 'ASC', level: level, tag: tag}) }}">{{ 'position.title'|trans }}</a></th>
                        <th>{{ 'position.company'|trans }}</th>
                        <th>{{ 'position.level'|trans }}</th>
                        <th>{{ 'position.visibility'|trans }}</th>
                        <th><a href="{{ path('app_position_index', {sort: 'updated', dir: dir == 'ASC' ? 'DESC' : 'ASC', level: level, tag: tag}) }}">{{ 'common.updated'|trans }}</a></th>
                        {% if is_granted('ROLE_RECRUITER') %}<th>{{ 'position.cv_count'|trans }}</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td><input type="radio" name="selected" value="{{ row.id }}" data-version="{{ row.version }}" data-table-toolbar-target="row" data-action="change->table-toolbar#refresh"></td>
                            <td><a href="{{ path('app_position_show', {id: row.id}) }}">{{ row.title }}</a></td>
                            <td>{{ row.company }}</td>
                            <td>{{ row.level ? ('position.level.' ~ (row.level.value ?? row.level))|trans : '' }}</td>
                            <td>{{ ('position.' ~ (row.visibility.value ?? row.visibility))|trans }}</td>
                            <td>{{ row.updatedAt|date('Y-m-d H:i') }}</td>
                            {% if is_granted('ROLE_RECRUITER') %}<td>{{ row.cvCount }}</td>{% endif %}
                        </tr>
                    {% else %}
                        <tr><td colspan="7">{{ 'position.empty'|trans }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
