{% extends 'base.html.twig' %}

{% block title %}{{ 'action.roles'|trans }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">{{ account.email }}</h1>
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <input type="hidden" name="version" value="{{ account.version }}">
        <button class="btn btn-primary" type="submit">{{ 'action.save'|trans }}</button>
        <a class="btn btn-outline-secondary" href="{{ path('app_admin_users') }}">{{ 'common.back'|trans }}</a>
    {{ form_end(form) }}
{% endblock %}
