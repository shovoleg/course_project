<odoo>
  <record id="view_import_wizard_form" model="ir.ui.view">
    <field name="name">course.position.import.wizard.form</field>
    <field name="model">course.position.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Import Position">
        <group>
          <field name="token" placeholder="Paste API token from Position → API token"/>
          <field name="base_url"/>
        </group>
        <footer>
          <button string="Import" type="object" name="action_import" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_import_wizard" model="ir.actions.act_window">
    <field name="name">Import Position</field>
    <field name="res_model">course.position.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
  <menuitem id="menu_import_wizard" name="Import by Token" parent="menu_course_position_root" action="action_import_wizard" sequence="2"/>
</odoo>
